{% extends "report-base.html.jinja" %}
{% block title %}Recipe Report{% endblock %}

{% block content %}
  <p>Each cell shows the version selected for that machine and the latest
    version found by the upstream checker. A dash means the recipe is
    unavailable; “unknown” means no upstream version was found.</p>
  <div class="table-container">
  <table class="table is-striped">
    <thead>
      <tr>
        <th>Machine</th>
        {% for recipe in recipes|sort %}
        <th>{{ recipe }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for machine, data in data|dictsort %}
      <tr>
        <th><a href="{{machine}}.html">{{ machine }}</a></th>
        {% for recipe in recipes|sort %}
          {% if recipe in data %}
            {% set details = data[recipe] %}
            <td style="text-align: center">
            <a href="{{machine}}.html#recipe-{{recipe|replace('/', '-') }}">
              {{ details.recipe if details.recipe != recipe}}
              {{ details.version }}
            </a>
            <br>
            <small>Latest: {{ details.upstream or "unknown" }}</small>
            {% if details.patches or details.needs_update or details.appends %}
            <br>
            {% if details.patches %}
              <span class="tag {{ "is-info" if details.patches_safe else "is-danger" }}">
                {% trans count=details.patches|length %}
                  {{ count }} Patch
                {% pluralize %}
                  {{ count }} Patches
                {% endtrans %}
              </span>
            {% endif %}
            {% if details.needs_update %}
              <span class="tag is-danger">Upgrade</span>
            {% endif %}
            {% if details.appends %}
              <span class="tag is-info">Appended</span>
            {% endif %}
            {% endif %}
            </td>
          {% else %}
            <td>-</td>
          {% endif %}
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
{% endblock %}
