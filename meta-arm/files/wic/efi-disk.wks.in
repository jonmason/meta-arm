# short-description: Create an EFI disk image
# long-description: Creates a partitioned EFI disk image that the user
# can directly dd to boot media.

part /boot --source bootimg-efi --sourceparams="loader=${EFI_PROVIDER}${@',dtb=' + d.getVar('KERNEL_DTB_NAME') if d.getVar('KERNEL_DTB_NAME') else ''}" --label boot --active --align 1024 --use-uuid

part / --source rootfs --fstype=ext4 --label root --align 1024 --use-uuid

part swap --size 44 --label swap --fstype=swap --use-uuid

bootloader --ptable gpt --timeout=5 --append="rootwait rootfstype=ext4 console=${KERNEL_CONSOLE} ${@d.getVar('EFI_DISK_BOOT_ARGS') or ''}"
