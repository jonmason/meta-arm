diff --git a/plat/arm/board/neoverse_rd/common/include/nrd_einj.h b/plat/arm/board/neoverse_rd/common/include/nrd_einj.h
new file mode 100644
index 000000000000..8f23518d5e2c
--- /dev/null
+++ b/plat/arm/board/neoverse_rd/common/include/nrd_einj.h
@@ -0,0 +1,50 @@
+/*
+ * Copyright (c) 2022, ARM Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * EINJ Error Type Definition
+ */
+#define EINJ_ERROR_PROCESSOR_CORRECTABLE               (1 << 0)
+#define EINJ_ERROR_PROCESSOR_UNCORRECTABLE_NONFATAL    (1 << 1)
+#define EINJ_ERROR_PROCESSOR_UNCORRECTABLE_FATAL       (1 << 2)
+#define EINJ_ERROR_MEMORY_CORRECTABLE                  (1 << 3)
+#define EINJ_ERROR_MEMORY_UNCORRECTABLE_NONFATAL       (1 << 4)
+#define EINJ_ERROR_MEMORY_UNCORRECTABLE_FATAL          (1 << 5)
+#define EINJ_ERROR_PCI_EXPRESS_CORRECTABLE             (1 << 6)
+#define EINJ_ERROR_PCI_EXPRESS_UNCORRECTABLE_NONFATAL  (1 << 7)
+#define EINJ_ERROR_PCI_EXPRESS_UNCORRECTABLE_FATAL     (1 << 8)
+#define EINJ_ERROR_PLATFORM_CORRECTABLE                        (1 << 9)
+#define EINJ_ERROR_PLATFORM_UNCORRECTABLE_NONFATAL     (1 << 10)
+#define EINJ_ERROR_PLATFORM_UNCORRECTABLE_FATAL                (1 << 11)
+/* EINJ vendor specific definitions */
+#define EINJ_ERROR_TYPE_VENDOR_BIT                     (1U << 31)
+
+#define EINJ_VENDOR_ERROR_TYPE_CMN_HNF ((1U << 16) | EINJ_ERROR_TYPE_VENDOR_BIT)
+
+#define ACTION_SET_ERROR_TYPE_WITH_ADDRESS_BASE NRD_CSS_EINJ_SET_ERROR_TYPE_ADDR
+
+/* Error injection pcie SBDF structure */
+typedef struct {
+       uint32_t reserved: 8;
+       uint32_t function: 3;
+       uint32_t device: 5;
+       uint32_t primaryOrDeviceBus: 8;
+       uint32_t segment: 8;
+} einj_pcie_sbdf;
+
+/* Error injection set error type with address structure */
+typedef struct {
+       uint32_t errorType;
+       uint32_t vendorErrorTypeOffset;
+       uint32_t flags;
+       uint32_t apicId;
+       uint64_t memAddress;
+       uint64_t memAddressRange;
+       einj_pcie_sbdf pcieSBDF;
+} einj_set_error_type_with_address;
+
+/* Error injection initialization function */
+int nrd_err_inj_init(void);
