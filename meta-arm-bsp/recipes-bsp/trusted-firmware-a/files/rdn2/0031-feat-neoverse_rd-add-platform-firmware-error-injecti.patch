index 000000000000..039c93ed8c88
--- /dev/null
+++ b/plat/arm/board/neoverse_rd/common/einj/nrd_einj.c
@@ -0,0 +1,134 @@
+/*
+ * Copyright (c) 2022, ARM Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include <bl31/ehf.h>
+#include <bl31/interrupt_mgmt.h>
+#include <plat/common/platform.h>
+
+#include <nrd_einj.h>
+
+#define ERR_INJ_INTR_EVT_ID 83
+
+#define GICD_BASE      0x30000000UL
+#define GICD_CLRSPI_NSR        0x0048
+
+/* Enables NS access to GICD CLRSPI and SETSPI registers. */
+#define EN_GICD_NS_ACCESS (0x2)
+
+/*
+ * To set spi interrupt ID 83 from non-secure software program GIC_NSACR<n>
+ * register.
+ * n = (83 / 16) = 5
+ * offset of register GIC_NSACR<5> = ((83 / 16) * 4)
+ */
+#define GICD_NSACR5_OFF (0xE00+((ERR_INJ_INTR_EVT_ID/16)*4))
+/*
+ * The value to be written to GICD_NSACR5_OFF,
+ * Spi int 83 bit positions in GICD_NSACR5 regiter = ((83 % 16) * 2) = 6
+ * as there are 2 bits per interrupt ID.
+ */
+#define GICD_EN_ID_83 (EN_GICD_NS_ACCESS << ((ERR_INJ_INTR_EVT_ID%16)*2))
+
+/*
+ * Configure interrupt routing to EL3 for error injection event.
+ */
+static void nrd_err_inj_interrupt_configure(int intr)
+{
+       plat_ic_set_interrupt_type(intr, INTR_TYPE_EL3);
+       plat_ic_set_interrupt_priority(intr, PLAT_EINJ_PRI);
+       plat_ic_clear_interrupt_pending(intr);
+       plat_ic_set_spi_routing(intr, INTR_ROUTING_MODE_ANY,
+                               (u_register_t)read_mpidr_el1());
+       plat_ic_enable_interrupt(intr);
+}
+
+/*
+ * error injection EL3 interrupt handler.
+ */
+static int err_inj_el3_interrupt_handler(uint32_t intr, uint32_t flags,
+               void *handle, void *cookie)
+{
+       uint32_t error_type;
+       einj_set_error_type_with_address *error_info;
+
+       INFO("EINJ event received %d\n", intr);
+
+       /* Clear the error injection interrupt. */
+       plat_ic_end_of_interrupt(intr);
+       mmio_write_32((GICD_BASE + GICD_CLRSPI_NSR), ERR_INJ_INTR_EVT_ID);
+
+       /* Read the error injection information */
+       error_info = (einj_set_error_type_with_address *)
+                       ACTION_SET_ERROR_TYPE_WITH_ADDRESS_BASE;
+
+       /* Process error injection event. */
+       INFO("Error Type = 0x%x\n", error_info->errorType);
+       error_type = error_info->errorType;
+
+       if (error_type & EINJ_ERROR_TYPE_VENDOR_BIT) {
+               switch (error_type) {
+               case EINJ_VENDOR_ERROR_TYPE_CMN_HNF:
+                       break;
+               default:
+                       ERROR("Error Injection failed: No device present of \
+                               type %d\n", error_type);
+               }
+       } else {
+               switch (error_type) {
+               case EINJ_ERROR_PROCESSOR_CORRECTABLE:
+                       INFO("EINJ_ERROR_PROCESSOR_CORRECTABLE\n");
+                       break;
+               case EINJ_ERROR_PROCESSOR_UNCORRECTABLE_NONFATAL:
+                       INFO("EINJ_ERROR_PROCESSOR_UNCORRECTABLE_NONFATAL\n");
+                       break;
+               case EINJ_ERROR_PROCESSOR_UNCORRECTABLE_FATAL:
+                       INFO("EINJ_ERROR_PROCESSOR_UNCORRECTABLE_FATAL\n");
+                       break;
+               default:
+                       ERROR("Error Injection failed: No device present of \
+                               type %d\n", error_type);
+               }
+       }
+
+       return 1;
+}
+
+/*
+ * Platform error injection init function.
+ * The error injection function programs GICD register to allow non secure
+ * access to  SPI interrupt id 83. It also registers einj interrupt event
+ * handler with the exception handling framework at EL3.
+ */
+int nrd_err_inj_init(void)
+{
+       uint32_t gicd_nsacr;
+
+       /*
+        * Allow SPI interrupt ID 83 to be programmed by non-secure software
+        * using the GID SETSPI register.
+        *
+        * Program the GICD NSACR<n>, n=5 register to open up interrupt ID 83
+        * to be programmed from non-secure software (using GICD SETSPI).
+        */
+       gicd_nsacr = mmio_read_32(GICD_BASE + GICD_NSACR5_OFF);
+       gicd_nsacr |= GICD_EN_ID_83;
+       mmio_write_32((GICD_BASE + GICD_NSACR5_OFF), gicd_nsacr);
+
+       /* Register handler for EL3 interrupts with the ehf framework */
+       ehf_register_priority_handler(PLAT_EINJ_PRI,
+                                       err_inj_el3_interrupt_handler);
+
+       /* Program GIC to enable SPI interrupt ID 83 */
+       nrd_err_inj_interrupt_configure(ERR_INJ_INTR_EVT_ID);
+
+       INFO("NRD: Error Injection interrupt handler registered \
+               successfully\n");
+
+       return 0;
+}
