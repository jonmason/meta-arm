 	uint64_t start;
@@ -114,28 +115,48 @@ void plat_arm_nrd_pcie_smmu_init(struct pcie_block_mmap_list *mmap_list)
 /* Copy PCIe memmap data from sds to a local buffer. */
 void plat_arm_nrd_get_pcie_mmap(struct pcie_block_mmap_list *mmap_list)
 {
+	struct {
+		uint64_t block_count;
+		uint64_t table_size;
+	} header;
+	sds_region_id_t region_id;
 	int ret;
 
-	ret = sds_init(SDS_SCP_AP_REGION_ID);
-	if (ret != SDS_OK) {
-		ERROR("SDS initialization failed. ret: %d\n", ret);
-		panic();
-	}
+	mmap_list->block_count = 0;
+	mmap_list->table_size = sizeof(header);
+	for (region_id = SDS_SCP_AP_CHIP0_REGION_ID;
+			region_id < SDS_SCP_AP_REGION_ID_MAX;
+			region_id++ ) {
 
-	ret = sds_struct_read(SDS_SCP_AP_REGION_ID,
-			      SDS_PCIE_MMAP_IDX, 0, mmap_list,
-			      sizeof(struct pcie_block_mmap_list),
-			      SDS_ACCESS_MODE_CACHED);
-	if (ret != SDS_OK) {
-		ERROR("SDS PCIE MMAP header read failed. ret: %d\n", ret);
-	}
+		ret = sds_init(region_id);
+		if (ret != SDS_OK) {
+			ERROR("SDS initialization failed. ret: %d\n", ret);
+			panic();
+		}
 
-	ret = sds_struct_read(SDS_SCP_AP_REGION_ID,
-			      SDS_PCIE_MMAP_IDX, 0, mmap_list,
-			      mmap_list->table_size,
-			      SDS_ACCESS_MODE_CACHED);
-	if (ret != SDS_OK) {
-		ERROR("SDS PCIE MMAP header read failed. ret: %d\n", ret);
+		ret = sds_struct_read(region_id,
+				SDS_PCIE_MMAP_IDX, 0, &header,
+				sizeof(header),
+				SDS_ACCESS_MODE_CACHED);
+		if (ret != SDS_OK) {
+			ERROR("SDS PCIE MMAP header read failed. ret: %d\n", ret);
+			continue;
+		}
+		INFO("Block count: 0x%"PRIx64"\n", header.block_count);
+		INFO("Table Size: 0x%"PRIx64"\n", header.table_size);
+
+		header.table_size -= sizeof(header);
+		ret = sds_struct_read(region_id,
+				SDS_PCIE_MMAP_IDX, sizeof(header),
+				(void *)((uint8_t *)mmap_list + mmap_list->table_size),
+				header.table_size,
+				SDS_ACCESS_MODE_CACHED);
+		if (ret != SDS_OK) {
+			ERROR("SDS PCIE MMAP header read failed. ret: %d\n", ret);
+			continue;
+		}
+		mmap_list->block_count += header.block_count;
+		mmap_list->table_size += header.table_size;
 	}
 }
 
