+void mhu_v3_get_secure_device_base(uintptr_t *base, bool sender)
+{
+#if ENABLE_RME
+	if (sender) {
+		*base = AP_RSE_ROOT_MHU_V3_PBX;
+	} else {
+		*base = AP_RSE_ROOT_MHU_V3_MBX;
+	}
+#else
+	if (sender) {
+		*base = AP_RSE_SECURE_MHU_V3_PBX;
+	} else {
+		*base = AP_RSE_SECURE_MHU_V3_MBX;
+	}
+#endif
+}
