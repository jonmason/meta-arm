diff --git a/plat/arm/board/neoverse_rd/platform/rdv3r1/platform.mk b/plat/arm/board/neoverse_rd/platform/rdv3r1/platform.mk
new file mode 100644
index 000000000000..f7bf9d59c594
--- /dev/null
+++ b/plat/arm/board/neoverse_rd/platform/rdv3r1/platform.mk
@@ -0,0 +1,166 @@
+# Copyright (c) 2024, Arm Limited and Contributors. All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+
+RD_V3_R1_VARIANTS := 0
+ifneq ($(NRD_PLATFORM_VARIANT),						\
+	$(filter $(NRD_PLATFORM_VARIANT),$(RD_V3_R1_VARIANTS)))
+	$(error "NRD_PLATFORM_VARIANT for RD-V3-R1 should be 0"
+	"currently set to ${NRD_PLATFORM_VARIANT}.")
+endif
+
+$(eval $(call CREATE_SEQ,SEQ,4))
+ifneq ($(NRD_CHIP_COUNT),$(filter $(NRD_CHIP_COUNT),$(SEQ)))
+	$(error  "Chip count for RD-V3-R1-MC should be either $(SEQ) \
+	currently it is set to ${NRD_CHIP_COUNT}.")
+endif
+
+# Build options
+# Major and Minor versions
+override ARM_ARCH_MAJOR			:= 8
+override ARM_ARCH_MINOR			:= 7
+
+# Image flags
+override CSS_SYSTEM_GRACEFUL_RESET	:= 0
+override EL3_EXCEPTION_HANDLING	:= 0
+
+# Misc options
+override CTX_INCLUDE_AARCH32_REGS	:= 0
+
+# RD-V3-R1 platform uses GIC-700 which is based on GICv4.1
+GIC_ENABLE_V4_EXTN			:= 1
+
+# Enable GIC multichip extension only for multichip platforms
+GICV3_IMPL_GIC600_MULTICHIP	:= 1
+
+# RD-V3-R1 uses MHUv3
+PLAT_MHU_VERSION := 3
+
+include plat/arm/board/neoverse_rd/common/nrd-common.mk
+include drivers/arm/rse/rse_comms.mk
+include drivers/auth/mbedtls/mbedtls_common.mk
+ifeq (${MEASURED_BOOT},1)
+include drivers/measured_boot/rse/rse_measured_boot.mk
+endif
+
+RDV3_R1_BASE	=	plat/arm/board/neoverse_rd/platform/rdv3r1
+
+PLAT_INCLUDES	+=	-I${NRD_COMMON_BASE}/include/nrd4/		\
+			-I${RDV3_R1_BASE}/include/
+ifeq (${MEASURED_BOOT},1)
+PLAT_INCLUDES	+=	-Iinclude/lib/psa
+endif
+
+NRD_CPU_SOURCES	:=	lib/cpus/aarch64/neoverse_v3.S
+
+# Source files for RD-V3-R1 variants
+PLAT_BL_COMMON_SOURCES							\
+		+=	${NRD_COMMON_BASE}/nrd_plat4.c			\
+			${RDV3_R1_BASE}/rdv3r1_common.c
+
+PLAT_MEASURED_BOOT_SOURCES						\
+		:=	${MEASURED_BOOT_SOURCES} 			\
+			${RSE_COMMS_SOURCES}				\
+			${RDV3_R1_BASE}/rdv3r1_common_measured_boot.c \
+			lib/psa/measured_boot.c
+
+BL1_SOURCES	+=	${NRD_CPU_SOURCES}				\
+			${RDV3_R1_BASE}/rdv3r1_err.c		\
+			${RDV3_R1_BASE}/rdv3r1_mhuv3.c
+ifeq (${TRUSTED_BOARD_BOOT}, 1)
+BL1_SOURCES	+=	${RDV3_R1_BASE}/rdv3r1_trusted_boot.c
+endif
+ifeq (${MEASURED_BOOT},1)
+BL1_SOURCES	+=	${PLAT_MEASURED_BOOT_SOURCES}			\
+			${RDV3_R1_BASE}/rdv3r1_bl1_measured_boot.c
+endif
+
+BL2_SOURCES	+=	${RDV3_R1_BASE}/rdv3r1_bl2_setup.c		\
+			${RDV3_R1_BASE}/rdv3r1_err.c		\
+			${RDV3_R1_BASE}/rdv3r1_mhuv3.c		\
+			${RDV3_R1_BASE}/rdv3r1_security.c		\
+			lib/utils/mem_region.c				\
+			plat/arm/common/arm_nor_psci_mem_protect.c	\
+			drivers/arm/smmu/smmu_v3.c
+ifeq (${TRUSTED_BOARD_BOOT}, 1)
+BL2_SOURCES	+=	${RDV3_R1_BASE}/rdv3r1_trusted_boot.c
+endif
+ifeq (${MEASURED_BOOT},1)
+BL2_SOURCES	+=	${PLAT_MEASURED_BOOT_SOURCES}			\
+			${RDV3_R1_BASE}/rdv3r1_bl2_measured_boot.c
+endif
+
+BL31_SOURCES	+=	${NRD_CPU_SOURCES}				\
+			${MBEDTLS_SOURCES}				\
+			${RSE_COMMS_SOURCES}				\
+			${RDV3_R1_BASE}/rdv3r1_bl31_setup.c	\
+			${RDV3_R1_BASE}/rdv3r1_mhuv3.c		\
+			${RDV3_R1_BASE}/rdv3r1_topology.c		\
+			${RDV3_R1_BASE}/rdv3r1_plat_attest_token.c	\
+			${RDV3_R1_BASE}/rdv3r1_realm_attest_key.c	\
+			drivers/arm/gic/v3/gic600_multichip.c	\
+			drivers/arm/smmu/smmu_v3.c			\
+			drivers/cfi/v2m/v2m_flash.c			\
+			lib/psa/cca_attestation.c			\
+			lib/psa/delegated_attestation.c			\
+			lib/utils/mem_region.c				\
+			plat/arm/common/arm_dyn_cfg.c			\
+			plat/arm/common/arm_nor_psci_mem_protect.c
+
+ifeq (${NRD_ERR_INJ_SUPPORT},1)
+BL31_SOURCES           +=      ${RDV3_R1_BASE}/einj/nrd_einj_sram.c	\
+				${RDV3_R1_BASE}/einj/nrd_einj_cpu.c
+endif
+
+# XLAT options for RD-V3-R1 variants
+BL31_CFLAGS	+=      -DPLAT_XLAT_TABLES_DYNAMIC
+BL2_CFLAGS	+=      -DPLAT_XLAT_TABLES_DYNAMIC
+
+ifeq (${ENABLE_FEAT_RAS}, 1)
+ifeq (${FFH_SUPPORT}, 1)
+BL31_SOURCES            +=      ${RDV3_R1_BASE}/rdv3r1_ras.c	\
+                                ${NRD_COMMON_BASE}/ras/nrd_ras_common.c	\
+                                ${NRD_COMMON_BASE}/ras/nrd_ras_sram.c	\
+				${NRD_COMMON_BASE}/ras/nrd_ras_cpu.c
+endif
+endif
+
+# Add the FDT_SOURCES and options for Dynamic Config
+FDT_SOURCES	+=	${RDV3_R1_BASE}/fdts/${PLAT}_fw_config.dts	\
+			${RDV3_R1_BASE}/fdts/${PLAT}_tb_fw_config.dts \
+			${RDV3_R1_BASE}/fdts/${PLAT}_nt_fw_config.dts \
+			${RDV3_R1_BASE}/fdts/${PLAT}_hw_config.dts
+
+FW_CONFIG	:=	${BUILD_PLAT}/fdts/${PLAT}_fw_config.dtb
+TB_FW_CONFIG	:=	${BUILD_PLAT}/fdts/${PLAT}_tb_fw_config.dtb
+NT_FW_CONFIG	:=	${BUILD_PLAT}/fdts/${PLAT}_nt_fw_config.dtb
+HW_CONFIG	:=	${BUILD_PLAT}/fdts/${PLAT}_hw_config.dtb
+
+# Add the FW_CONFIG to FIP and specify the same to certtool
+$(eval $(call TOOL_ADD_PAYLOAD,${FW_CONFIG},--fw-config,${FW_CONFIG}))
+# Add the TB_FW_CONFIG to FIP and specify the same to certtool
+$(eval $(call TOOL_ADD_PAYLOAD,${TB_FW_CONFIG},--tb-fw-config,${TB_FW_CONFIG}))
+# Add the NT_FW_CONFIG to FIP and specify the same to certtool
+$(eval $(call TOOL_ADD_PAYLOAD,${NT_FW_CONFIG},--nt-fw-config))
+$(eval $(call TOOL_ADD_PAYLOAD,${HW_CONFIG},--hw-config))
+
+# Features for RD-V3-R1 variants
+override ENABLE_FEAT_MPAM	:= 2
+override ENABLE_FEAT_AMU	:= 2
+override ENABLE_SVE_FOR_SWD	:= 1
+override ENABLE_SVE_FOR_NS	:= 2
+override ENABLE_FEAT_MTE2	:= 2
+
+ifeq (${SPMD_SPM_AT_SEL2}, 1)
+BL32_CONFIG_DTS		:=	${RDV3_R1_BASE}/fdts/${PLAT}_spmc_sp_manifest.dts
+FDT_SOURCES		+=	${BL32_CONFIG_DTS}
+TOS_FW_CONFIG		:=	${BUILD_PLAT}/fdts/$(notdir $(basename ${BL32_CONFIG_DTS})).dtb
+endif
+
+# Firmware Configuration Framework sources
+include lib/fconf/fconf.mk
+
+BL1_SOURCES	+=	${FCONF_SOURCES} ${FCONF_DYN_SOURCES}
+BL2_SOURCES	+=	${FCONF_SOURCES} ${FCONF_DYN_SOURCES}
+BL31_SOURCES	+=	${FCONF_SOURCES} ${FCONF_DYN_SOURCES}
