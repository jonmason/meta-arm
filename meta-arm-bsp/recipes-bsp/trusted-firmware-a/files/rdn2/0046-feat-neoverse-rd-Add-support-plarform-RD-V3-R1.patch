index 000000000000..af8276116e64
--- /dev/null
+++ b/plat/arm/board/neoverse_rd/platform/rdv3r1/einj/nrd_einj_sram.c
@@ -0,0 +1,55 @@
+/*
+ * Copyright (c) 2023-2024, Arm Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+#include <common/debug.h>
+#include <lib/mmio.h>
+#include <rdv3r1_ras.h>
+#include <platform_def.h>
+
+#define AP_RT_RAM_ECC_RAS_BASE  NRD_CSS_ROOT_SRAM_ERB_AP_BASE
+#define ROOT_RAM_BASE_ADDR      0x19100UL
+
+/*Shared SRAM ECC RAS register offsets*/
+#define SRAM_ENABLE_ECC              (1U << 0)
+#define SRAM_INJECT_CE_BIT           (1U << 8)
+#define SRAM_INJECT_ERROR_CE         (1U << 4)
+#define SRAM_INJECT_UE_BIT           (1U << 3)
+#define SRAM_INJECT_ERROR_UE         (1U << 3)
+
+#define SRAM_ERR_CTRL_OFFSET          0x08UL
+#define SRAM_ERR_STATUS_OFFSET        0x10UL
+#define SRAM_ERR_ADDR_OFFSET          0x18UL
+#define SRAM_ERR_MISC1_OFFSET         0x28UL
+
+/*
+ * Function that performs 1-bit CE injection into Secure base element ram.
+ * Programs error control register belonging to register bank AP secure ram ecc
+ * ras registers to inject 1-bit CE. After that initiates a read operation to
+ * any secure ram location. This triggers the injection, populates the error
+ * and generates a fault handling interrupt to AP.
+ */
+void nrd_sram_inject_error(void)
+{
+        uint64_t addr_s = ROOT_RAM_BASE_ADDR;
+        volatile uint32_t data;
+
+        /* Program AP Secure RAM error record control register to inject 1-bit
+         * error
+         */
+        mmio_write_32((AP_RT_RAM_ECC_RAS_BASE + SRAM_ERR_CTRL_OFFSET),
+            SRAM_INJECT_CE_BIT |
+            SRAM_INJECT_UE_BIT |
+            SRAM_ENABLE_ECC);
+
+        INFO("Injecting CE\n");
+        mmio_write_32((AP_RT_RAM_ECC_RAS_BASE + SRAM_ERR_MISC1_OFFSET),
+                    SRAM_INJECT_ERROR_CE);
+
+        /* For injection to take effect make read access to any Secure RAM
+         * location from AP.
+         */
+        data = *(volatile uint32_t *)addr_s;
+        INFO("Accessing Root RAM location 0x%lx = 0x%x\n", addr_s, data);
+}
