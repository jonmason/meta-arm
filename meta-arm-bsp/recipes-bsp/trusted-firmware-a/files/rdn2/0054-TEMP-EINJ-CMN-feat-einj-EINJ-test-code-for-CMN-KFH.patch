diff --git a/plat/arm/board/neoverse_rd/common/ras_tests/cmn_cyprus/src.c b/plat/arm/board/neoverse_rd/common/ras_tests/cmn_cyprus/src.c
new file mode 100644
index 000000000000..902463d8ecdf
--- /dev/null
+++ b/plat/arm/board/neoverse_rd/common/ras_tests/cmn_cyprus/src.c
@@ -0,0 +1,147 @@
+/*
+ * CMN800 HNF error injection.
+ * Functions implemented tp support  both transaction based injection and PFG
+ * registers injection.
+ *
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <drivers/console.h>
+#include <plat/common/platform.h>
+#include <cmn_ras.h>
+
+#define CMN_BASE_ADDRESS        0x00100000000
+#define HNS0_XP_11_P0           0x1700000
+#define ED_ENABLE               (1UL << 0)
+#define UI_ENABLE               (1UL << 2)
+#define FI_ENABLE               (1UL << 3)
+#define CFI_ENABLE              (1UL << 8)
+#define DUI_ENABLE              (1UL << 10)
+#define PAR_ERR_EN              (1UL << 32)
+
+/* CMN CFGM registers base */
+#define ERRGSR_SRA_BASE         0x4e00
+#define CFGM_RAS_MODE           0xA00
+
+/* CMN error records offsets */
+#define ErrFr                   0xe040
+#define ErrCtlr                 0xe048
+#define ErrStatus               0xe050
+#define ErrAddr                 0xe058
+#define ErrMisc                 0xe060
+#define ErrMisc1                0xe068
+#define HNS_ERR_INJ_OFF         0xe030
+#define HNS_PAR_ERR_INJ_OFF     0xe938
+
+/* HNF double bit error injection register specific bit fields. */
+#define HNS_ERR_INJ_EN         (1 << 0)
+#define HNS_ERR_INJ_SRC_ID_POS 16
+#define CPU0_NODE_ID            0x2C
+
+void print_rec_register(char* node_name, uint8_t idx,
+                                                 uint64_t node_base)
+{
+        INFO ("Node Base = 0x%lx\n", CMN_BASE_ADDRESS + node_base);
+        INFO ("ErrFr = 0x%lx\n", mmio_read_64 (CMN_BASE_ADDRESS + node_base + ErrFr));
+        INFO ("ErrCtlr = 0x%lx\n", mmio_read_64 (CMN_BASE_ADDRESS + node_base + ErrCtlr));
+        INFO ("ErrStatus = 0x%lx\n", mmio_read_64 (CMN_BASE_ADDRESS + node_base + ErrStatus));
+        INFO ("ErrAddr = 0x%lx\n", mmio_read_64 (CMN_BASE_ADDRESS + node_base + ErrAddr));
+        INFO ("ErrMisc = 0x%lx\n", mmio_read_64 (CMN_BASE_ADDRESS + node_base + ErrMisc));
+        INFO ("ErrMisc1 = 0x%lx\n", mmio_read_64 (CMN_BASE_ADDRESS + node_base + ErrMisc1));
+        INFO ("ErrGsr = 0x%lx\n", mmio_read_64 (CMN_BASE_ADDRESS + node_base + 0xEE00));
+
+        if ((mmio_read_64((CMN_BASE_ADDRESS + 0xA00))) == 0) {
+                INFO ("Log the ErrGsr's\n");
+                INFO ("HNF 0 ID 40 ErrFr0_sra3 = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + 0x7000)));
+		INFO ("HNF 0 ID 40 ErrStatus0_sra3 = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + 0x7010)));
+                for(int i = 0; i < 12; i++) {
+                        INFO ("ErrGsr%d_sra%d = 0x%lx\n", i, i, mmio_read_64((CMN_BASE_ADDRESS + ERRGSR_SRA_BASE + ((0x1000) * i))));
+                }
+        } else {
+                INFO ("Log the SRA's\n");
+                INFO ("HNF 0 ID 40 ErrStatus0_sra3 = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + 0x7000)));
+                INFO ("HNF 0 ID 40 ErrStatus0_sra3 = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + 0x7010)));
+                for(int i = 0; i < 12; i++) {
+                        INFO ("ErrGsr%d_sra%d = 0x%lx\n", i, i, mmio_read_64((CMN_BASE_ADDRESS + ERRGSR_SRA_BASE + ((0x1000) * i))));
+                }
+        }
+}
+
+/*********************************************************************************
+HNF error detection programming.
+**********************************************************************************/
+void enable_err_det(char* node_name, uint64_t node_base_ofset)
+{
+        /* Program the control register to enable HNS error detection */
+        INFO ("\n\n Enable HNS error detectioni for %s@0x%lx\n\n", node_name, node_base_ofset);
+        INFO ("HNF node info = 0x%lx\n", mmio_read_64(CMN_BASE_ADDRESS + node_base_ofset));
+	INFO ("RAS 2.0 enabled = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + 0xA00)));
+        INFO ("RAS RCR = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + 0xA00)));
+        INFO ("RAS SCR enabled = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + 0xA00)));
+	mmio_write_64((CMN_BASE_ADDRESS + 0x988), 0x1);
+	mmio_write_64((CMN_BASE_ADDRESS + 0x990), 0x1);
+	//mmio_write_64((CMN_BASE_ADDRESS + 0xA00), 0x1);
+        INFO ("RAS 2.0 enabled = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + 0xA00)));
+        mmio_write_64 ((CMN_BASE_ADDRESS + node_base_ofset + ErrCtlr),
+                        (ED_ENABLE|UI_ENABLE|FI_ENABLE|CFI_ENABLE));
+        INFO ("ErrCtlr = 0x%lx\n", mmio_read_64(CMN_BASE_ADDRESS + node_base_ofset +
+                                                ErrCtlr));
+        INFO ("ErrIdr = 0x%lx\n", mmio_read_64(CMN_BASE_ADDRESS + node_base_ofset +
+                                                0xEE10));
+        INFO ("ErrDevId = 0x%lx\n", mmio_read_64(CMN_BASE_ADDRESS + node_base_ofset +
+                                                0xEFC8));
+}
+
+/*********************************************************************************
+Error injection using error injection PFG registers
+**********************************************************************************/
+#define PFG_INJECT_CE 1UL<<6
+#define PFG_INJECT_DE 1UL<<5
+#define PFG_INJECT_UEU 1UL<<2
+#define PFG_INJECT_PN 1UL<<10
+#define PFG_EN_AV 1UL<<11
+#define PFG_EN_MV 1UL<<12
+#define PFG_EN_CDN 1UL<<31
+
+/* Supports PFG error injection to any nodes XP/HNF/HNI/SBSX/CCG at a time.
+   Params:
+        node_name: Name of the node
+        inj_type: type of injection CE/DE/UEU/PN
+        lid: Logical ID of the node
+        node_base_offset: Offset of the node.
+*/
+void inject_using_pfg_register(char* node_name, int inj_type, int lid,
+                                uint64_t node_base_ofset)
+{
+        uint64_t pfgctl_val;
+
+        INFO ("\n %s%d injection using PFG registers \n", node_name, lid);
+
+        switch (inj_type) {
+                case CE:
+                        pfgctl_val = PFG_INJECT_CE;
+                break;
+                case DE:
+                        pfgctl_val = PFG_INJECT_DE;
+                break;
+                case UEU:
+                        pfgctl_val = PFG_INJECT_UEU;
+                break;
+                case PN:
+                        pfgctl_val = PFG_INJECT_PN;
+                break;
+                default:
+                        INFO ("%s: Wrong injection type selected \n", __func__);
+                        return;
+        }
+        INFO ("ErrPfgf = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + node_base_ofset + 0xe840)));
+        /* Program PfgCdn to 1, so inject error after 1 clock tick. */
+        mmio_write_64 ((CMN_BASE_ADDRESS + node_base_ofset + 0xe850), 0x1);
+        mmio_write_64 ((CMN_BASE_ADDRESS + node_base_ofset + 0xe848), (PFG_EN_CDN | PFG_EN_MV | PFG_EN_AV | pfgctl_val));
+        INFO ("ErrPfgCtl = 0x%lx\n", mmio_read_64((CMN_BASE_ADDRESS + node_base_ofset + 0xe848)));
+        print_rec_register (node_name, lid, node_base_ofset);
+}
