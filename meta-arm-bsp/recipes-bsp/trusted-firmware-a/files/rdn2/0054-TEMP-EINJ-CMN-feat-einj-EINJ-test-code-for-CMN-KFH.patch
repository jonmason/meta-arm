--- /dev/null
+++ b/plat/arm/board/neoverse_rd/platform/rdv3/rdfremont_einj.c
@@ -0,0 +1,37 @@
+/*
+ * Copyright (c) 2023-2024, Arm Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+#include <common/debug.h>
+#include <lib/mmio.h>
+#include <rdv3_ras.h>
+#include <platform_def.h>
+#include <cmn_ras.h>
+
+#define HNS0_XP_11_P0           0x1700000
+#define HNI0_XP_00_P0		0x300000
+#define SBSX0_XP_20_P1		0x2820000
+#define XP8_XP_22		0x2820000
+
+/*
+ * error injection EL3 interrupt handler.
+ */
+int nrd_einj_handler(uint64_t type, uint64_t flags,
+                uint64_t data)
+{ 
+     INFO ("nrd_einj_handler called\n");
+
+     enable_err_det("HNF", HNS0_XP_11_P0);
+     inject_using_pfg_register("HNS", DE, 0, HNS0_XP_11_P0);
+
+     enable_err_det("HNI", HNI0_XP_00_P0);
+     inject_using_pfg_register("HNI", DE, 0, HNI0_XP_00_P0);
+
+     enable_err_det("XP", XP8_XP_22);
+     inject_using_pfg_register("XP", DE, 0, XP8_XP_22);
+
+	enable_err_det("XP", XP8_XP_22);
+     inject_using_pfg_register("XP", CE, 0, XP8_XP_22);
+     return 0;
+}
