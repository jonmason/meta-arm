+
+void enable_ras_2_0();
+void inject_cmn_hns0_2bit_err();
+void inject_cmn_hns0_flit_parity_err();
+void enable_err_det(char* node_name, uint64_t node_base_ofset);
+void print_rec_register(char* node_name, uint8_t idx,
+                        uint64_t node_base);
+
+enum inj_type {
+        CE,
+        DE,
+        UEU,
+        PN
+};
+
+/* Supports PFG error injection to any nodes XP/HNF/HNI/SBSX/CCG at a time.
+    Params:
+         node_name: Name of the node
+         inj_type: type of injection CE/DE/UEU/PN
+         lid: Logical ID of the node
+         node_base_offset: Offset of the node.
+ */
+ void inject_using_pfg_register(char* node_name, int inj_type, int lid,
+                                 uint64_t node_base_ofset);
+
+#endif /* CMN_RAS_TESTS_H */
