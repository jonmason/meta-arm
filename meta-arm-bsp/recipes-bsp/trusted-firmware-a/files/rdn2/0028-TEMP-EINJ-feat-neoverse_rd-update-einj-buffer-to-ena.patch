From a6e148235aa37ac625359ccbc0239c2d33466e07 Mon Sep 17 00:00:00 2001
From: Omkar Anand Kulkarni <omkar.kulkarni@arm.com>
Date: Mon, 14 Apr 2025 14:13:21 +0530
Subject: [PATCH] [TEMP][EINJ] feat(neoverse_rd): update einj buffer to enable
 kernel first

Hack to enable kernel first support.

Signed-off-by: Omkar Anand Kulkarni <omkar.kulkarni@arm.com>
Change-Id: Idc1dbc25734e3f910b3be2fc823fc936bdfab59c

Signed-off-by: Jon Mason <jon.mason@arm.com>
Upstream-Status: Pending
---
 .../common/include/nrd3/nrd_plat_arm_def3.h           | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/plat/arm/board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h b/plat/arm/board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h
index b7326e30a1d2..d180e869e397 100644
--- a/plat/arm/board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h
+++ b/plat/arm/board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h
@@ -56,8 +56,8 @@
  * chips are accessed - secure ram, css device and soc device regions.
  */
 #if defined(IMAGE_BL31)
-#  define PLAT_ARM_MMAP_ENTRIES		(11 + ((NRD_CHIP_COUNT - 1) * 3))
-#  define MAX_XLAT_TABLES		(11 + ((NRD_CHIP_COUNT - 1) * 3))
+#  define PLAT_ARM_MMAP_ENTRIES		(12 + ((NRD_CHIP_COUNT - 1) * 3))
+#  define MAX_XLAT_TABLES		(12 + ((NRD_CHIP_COUNT - 1) * 3))
 #elif defined(IMAGE_BL32)
 # define PLAT_ARM_MMAP_ENTRIES		U(8)
 # define MAX_XLAT_TABLES		U(5)
@@ -751,7 +751,7 @@ typedef enum sds_region_id {
                                         ARM_CPER_DRAM1_SIZE -          \
                                         1U)
 #else
-#define ARM_CPER_DRAM1_SIZE             UL(0)
+#define ARM_CPER_DRAM1_SIZE             UL(0x00010000) /* 64KB *//*TODO: remove*/
 #endif /* ENABLE_FEAT_RAS && FFH_SUPPORT */
 
 /*******************************************************************************
@@ -763,6 +763,11 @@ typedef enum sds_region_id {
 #ifdef ARM_CPER_DRAM1_BASE
 #define ARM_EINJ_DRAM1_BASE		(ARM_CPER_DRAM1_BASE -	\
 						ARM_EINJ_DRAM1_SIZE)
+#else
+#define ARM_EINJ_DRAM1_BASE		(PLAT_ARM_SPMC_BASE - \
+					ARM_CPER_DRAM1_SIZE - \
+					ARM_EINJ_DRAM1_SIZE)
+#endif
 #define ARM_EINJ_DRAM1_END		(ARM_EINJ_DRAM1_BASE +		\
 					ARM_EINJ_DRAM1_SIZE -		\
 					1U)
