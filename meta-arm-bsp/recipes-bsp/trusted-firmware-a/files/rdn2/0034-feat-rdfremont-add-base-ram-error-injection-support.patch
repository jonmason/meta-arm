+
 #define ARM_IRQ_SEC_PHY_TIMER		U(29)
 
 #define ARM_IRQ_SEC_SGI_0		U(8)
diff --git a/plat/arm/board/neoverse_rd/platform/rdv3/einj/nrd_einj_sram.c b/plat/arm/board/neoverse_rd/platform/rdv3/einj/nrd_einj_sram.c
new file mode 100644
index 000000000000..305e7b53cb8c
--- /dev/null
+++ b/plat/arm/board/neoverse_rd/platform/rdv3/einj/nrd_einj_sram.c
@@ -0,0 +1,55 @@
+/*
