+++ b/Platform/ARM/SgiPkg/RdN2Cfg1/RdN2Cfg1.dsc
@@ -36,6 +36,8 @@ DEFINE PCIE_ENABLE             = TRUE
 # include common/basic libraries from MdePkg.
 !include DynamicTablesPkg/DynamicTables.dsc.inc
 
+DEFINE PCIE_ENABLE             = TRUE
+
 ################################################################################
