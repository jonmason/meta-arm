+
 #define CORES_PER_CLUSTER  1
 #if (PLATFORM_VARIANT == 0)
 #define NUMBER_OF_CLUSTERS 16
@@ -40,6 +42,16 @@
 
 // clang-format on
 
+#if (PLATFORM_VARIANT == 0)
