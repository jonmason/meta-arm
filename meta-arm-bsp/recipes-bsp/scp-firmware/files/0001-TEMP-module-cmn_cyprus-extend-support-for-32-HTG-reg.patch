 void rnsam_enable_htg_cal_mode(
     struct cmn_cyprus_rnsam_reg *rnsam,
     uint8_t scg_idx)
 {
-    /* Enable the CAL mode for the given SCG region */
-    rnsam->SYS_CACHE_GRP_CAL_MODE |=
-        (RNSAM_SCG_HNS_CAL_MODE_EN << (scg_idx * RNSAM_SCG_HNS_CAL_MODE_SHIFT));
+    uint8_t reg_idx;
+
+    /* Calculate the register index */
+    reg_idx = (scg_idx / RNSAM_SCG_HNS_CAL_MODE_SCG_PER_REG);
+
+    if (reg_idx < RNSAM_HTG_CAL_MODE_REG_GRP1_COUNT) {
+        /* Enable the CAL mode for the given SCG region */
+        rnsam->SYS_CACHE_GRP_CAL_MODE[reg_idx] |=
+            (RNSAM_SCG_HNS_CAL_MODE_EN << RNSAM_SCG_HNS_CAL_MODE_POS(scg_idx));
+    } else {
+        reg_idx = (reg_idx - RNSAM_HTG_CAL_MODE_REG_GRP1_COUNT);
+        /* Enable the CAL mode for the given SCG region */
+        rnsam->HASHED_TARGET_GROUP_HN_COUNT_REG[reg_idx] |=
+            (RNSAM_SCG_HNS_CAL_MODE_EN << RNSAM_SCG_HNS_CAL_MODE_POS(scg_idx));
