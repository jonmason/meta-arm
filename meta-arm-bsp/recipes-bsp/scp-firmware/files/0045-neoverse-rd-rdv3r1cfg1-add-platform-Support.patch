 add_executable(rdv3r1-lcp-bl2)
 
+# SCP_PLATFORM_VARIANT value for supported RD-V3-R1 platform variants:
+# - '0' for RD-V3-R1 platform
+# - '1' for RD-V3-R1-Cfg1 platform
