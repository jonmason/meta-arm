@@ -14,13 +14,17 @@
 
 #define PLATFORM_CORE_PER_CLUSTER_MAX 1
 
+#define NUMBER_OF_ROOTPORTS 4
 #define CORES_PER_CLUSTER 1
 #if (PLATFORM_VARIANT == 0 || PLATFORM_VARIANT == 3)
